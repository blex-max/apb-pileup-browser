Bootstrap: docker
From: debian:bookworm-slim
Stage: build

%files
    CMakeLists.txt /opt/pileup-browser/CMakeLists.txt
    src /opt/pileup-browser/src
    tests /opt/pileup-browser/tests

%post
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        git \
        ca-certificates \
        libsqlite3-dev \
        libhts-dev
    cd /opt/pileup-browser
    cmake -S . -B build
    cmake --build build -j"$(nproc)"

Bootstrap: docker
From: debian:bookworm-slim

%files from build
    /opt/pileup-browser/build/apb /usr/local/bin/apb

%post
    apt-get update
    apt-get install -y --no-install-recommends \
        libsqlite3-0 \
        libhts3
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/apb "$@"

%help
    apb is a terminal (TUI) genomics pileup browser.

    See `singularity run apb.sif --help` for usage.
