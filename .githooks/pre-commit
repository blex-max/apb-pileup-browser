#!/usr/bin/env bash
set -euo pipefail

staged=$(git diff --name-only --staged)
current_branch=$(git symbolic-ref --short -q HEAD || true)

# MANUAL.md is derived from the built binary — it embeds the live command
# registry's reference table, so regenerating it requires apb to actually
# compile. That isn't a fair bar for in-progress work on other branches, so
# the guarantee is only that main carries an up-to-date manual; branches may
# drift until merged. README.md is hand-maintained and not generated at all.
if [ "$current_branch" = "main" ] &&
  printf '%s\n' "$staged" | grep -qE '^src/app/(cmd|manual)\.(cpp|hpp)$'; then
  ./dev-scripts/gen-manual.sh
  git add MANUAL.md
fi

# clang-tidy checks
# Requires the code to build (clang-diagnostic-error), which isn't a fair bar
# for in-progress work on other branches — only gate commits landing on main.
tidy_checks='-*,readability-implicit-bool-conversion,readability-qualified-auto,readability-redundant-casting,readability-simplify-boolean-expr,readability-use-std-min-max'
if [ "$current_branch" = "main" ] && printf '%s\n' "$staged" | grep -qE '\.(cpp|hpp)$'; then
  if ! command -v run-clang-tidy >/dev/null 2>&1; then
    echo "pre-commit: run-clang-tidy not found, skipping readability gate" >&2
  elif [ ! -f build/compile_commands.json ]; then
    echo "pre-commit: build/compile_commands.json not found (configure build/ first), skipping readability gate" >&2
  else
    tidy_log=$(mktemp)
    trap 'rm -f "$tidy_log"' EXIT
    isysroot_arg=()
    if [[ "$(uname -s)" == "Darwin" ]] && command -v xcrun >/dev/null 2>&1; then
      isysroot_arg=(-extra-arg="-isysroot$(xcrun --show-sdk-path)")
    fi
    if ! run-clang-tidy -quiet -p build -checks="$tidy_checks" \
        -warnings-as-errors='*' "${isysroot_arg[@]}" \
        "^$(pwd)/src/" >"$tidy_log" 2>&1; then
      echo "pre-commit: clang-tidy found blocking readability issues:" >&2
      grep -E ': (error|warning):' "$tidy_log" >&2
      echo "pre-commit: please fix these" >&2
      exit 1
    fi
  fi
fi

if ! command -v clang-format >/dev/null 2>&1; then
  echo "pre-commit: clang-format not found, skipping format check" >&2
  exit 0
fi

# git clang-format only reformats lines touched by what's staged for this commit
# — pre-existing formatting elsewhere in the file is left alone.
#
# Files already dirty before we format: their unstaged hunks were deliberately
# held back, so they must not be swept into this commit by the re-stage below.
dirty_before=$(git diff --name-only -- $staged)

# git clang-format exits 1 when it reformatted something and 2 on a real error
# (e.g. it refuses to rewrite a file that has unstaged changes). Only 2 should
# abort the commit — 1 means "fixed it", so format and commit rather than
# making the user re-run the same command.
status=0
git clang-format --staged || status=$?
if [ "$status" -gt 1 ]; then
  exit "$status"
fi

# git clang-format writes to the working tree, not the index, so re-stage what
# it touched. Anything already dirty beforehand is excluded: a file cannot be
# both dirty-before and reformatted, since the exit-2 case above covers that.
if [ -n "$staged" ]; then
  changed=$(git diff --name-only -- $staged |
    grep -Fxv -f <(printf '%s\n' "$dirty_before") || true)
  if [ -n "$changed" ]; then
    echo "pre-commit: clang-format adjusted staged changes in:"
    echo "$changed"
    echo "$changed" | xargs git add
  fi
fi
