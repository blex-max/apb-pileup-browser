#!/usr/bin/env bash
set -euo pipefail

# Merges into main must compile. MANUAL.md is regenerated by post-merge, since
# the merge commit's contents are already fixed by the time this hook runs.
# Merges into dev only report a failed build.
current_branch=$(git symbolic-ref --short -q HEAD || true)

build() {
  [ -f build/CMakeCache.txt ] || cmake -S . -B build
  cmake --build build -j
}

case "$current_branch" in
  main) build ;;
  dev) build || echo "pre-merge-commit: build failed on dev, continuing" >&2 ;;
esac
