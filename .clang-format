---
BasedOnStyle: Google
Language: Cpp
Standard: c++20

UseTab: Never
ColumnLimit: 75 # allows splitscreen on my tiny screens in my massive font

# changes to make reformatting
# just about bearable

MaxEmptyLinesToKeep: 2

IndentCaseLabels: false

SpaceBeforeParens: NonEmptyParentheses

PointerAlignment: Left
ReferenceAlignment: Left

AlignAfterOpenBracket: BlockIndent

BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  BeforeCatch: true
  BeforeElse: true

InsertBraces: true

ReflowComments: false
AlignTrailingComments:
  Kind: Leave


Macros:
  - 'DEF_EXPAND_LAMBDA=[](std::string_view s, size_t pos, std::string* out) -> incr_else_errmsg_t'
